    {
      "id": "claude-acc.ultra.hook-wait-async",
      "area": "Ultra",
      "metric": "hook wait on every agent tool call",
      "unit": "ms",
      "better": "lower",
      "before": {
        "subject": "synchronous memory (cavemem) hook",
        "median": 53,
        "note": "p50; p90 73 ms"
      },
      "after": {
        "subject": "the same hook with \"async\": true",
        "median": 24,
        "note": "p50; p90 30 ms"
      },
      "date": "2026-10-04",
      "source": "readme",
      "commit": "e90c92f",
      "note": "From Claude Code transcripts, Orca with nine Claude Code sessions running."
    },
