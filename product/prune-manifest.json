{
  "about": "Files Pod inherits from Orca but never ships, builds or runs. product/scripts/pod-prune.mjs deletes them as the last generated layer of the stack; a file a kept file still refers to is held back instead (see the script). Every entry says why it is not Pod's.",
  "protect": [
    ".github/README.md",
    ".github/assets/**",
    ".github/workflows/upstream-sync.yml",
    ".github/workflows/pod-*.yml",
    ".github/actions/install-node-dependencies/**",
    ".github/actions/restore-pnpm-verification/**",
    ".github/actions/prepare-native-runtime/**",
    ".github/actions/install-mobile-dependencies/**",
    "scripts/pod-*",
    "product/**",
    "src/shared/product/**",
    "pod-stack.json",
    "upstream.json",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "baselines": [
    {
      "file": "config/max-lines-baseline.txt",
      "format": "lines"
    },
    {
      "file": "config/ts-nocheck-baseline.txt",
      "format": "lines"
    },
    {
      "file": "config/process-host-direct-import-baseline.txt",
      "format": "lines"
    },
    {
      "file": "config/runtime-electron-baseline.txt",
      "format": "lines"
    },
    {
      "file": "config/localization-coverage-allowlist.json",
      "format": "json-array",
      "key": "filePath"
    }
  ],
  "ignoreReferrers": [
    {
      "glob": ".gitignore",
      "reason": "ignore patterns: one for a pruned path matches nothing"
    },
    {
      "glob": ".gitattributes",
      "reason": "attribute patterns: one for a pruned path matches nothing"
    },
    {
      "glob": ".oxlintrc.json",
      "reason": "lint ignore patterns: one for a pruned path matches nothing"
    },
    {
      "glob": ".oxfmtrc.json",
      "reason": "format ignore patterns: one for a pruned path matches nothing"
    },
    {
      "glob": "config/scripts/ci-shard-timings.json",
      "reason": "unit shard timings: the balancer skips a file that is gone"
    },
    {
      "glob": "**/*.{md,mdx}",
      "except": ["README.md", "docs/readme/**", ".github/README.md"],
      "reason": "prose: a mention breaks nothing; the READMEs stay because check:readme-local-links follows their links"
    },
    {
      "glob": "config/scripts/{pr-code-change-scope,node-server-change-scope,node-server-qualification}.mjs",
      "reason": "change-scope tables of Orca's PR CI: they classify changed paths and never read them"
    },
    {
      "glob": "config/scripts/vitest-node-runtime-files.mjs",
      "reason": "vitest include globs: a pruned test matches nothing"
    }
  ],
  "inertWhenHeld": [
    {
      "glob": ".github/workflows/*",
      "reason": "Pod never runs an Orca workflow: one kept only because a kept test reads it holds nothing else"
    }
  ],
  "entries": [
    {
      "id": "orca-workflows",
      "category": "github",
      "reason": "Orca's GitHub Actions: Stably cloud deploys, Orca's releases and dev builds, Windows, Linux and mobile CI. Pod's CI is upstream-sync.yml and pod-*.yml; scripts/pod-workflow-quarantine.sh still disables any Orca workflow a push registers",
      "paths": [".github/workflows/*"],
      "except": [".github/workflows/upstream-sync.yml", ".github/workflows/pod-*.yml"]
    },
    {
      "id": "orca-actions",
      "category": "github",
      "reason": "Composite actions only Orca's workflows use (Cloud SQL rollout lease, SignPath, Linux package fixtures, headless compiler, xterm, git compatibility)",
      "paths": [".github/actions/**"],
      "except": [
        ".github/actions/{install-node-dependencies,restore-pnpm-verification,prepare-native-runtime,install-mobile-dependencies}/**"
      ]
    },
    {
      "id": "orca-github-meta",
      "category": "github",
      "reason": "Orca's issue forms, Stably's code owners, Dependabot for Orca, and the scripts of Orca's PR and README-badge workflows",
      "paths": [
        ".github/ISSUE_TEMPLATE/**",
        ".github/CODEOWNERS",
        ".github/dependabot.yml",
        ".github/scripts/**"
      ]
    },
    {
      "id": "orca-ci-scripts",
      "category": "github",
      "reason": "Scripts and contract tests that exist only for Orca's pruned workflows: dev/daily/hourly build versions, release tooling, CI runner metrics, mobile and Wayland checks, the Windows SSH provider image",
