  "walks": [
    {
      "name": "a device shut down from outside while leased comes back ready, its lease still live",
      "machine": "device",
      "start": "leased",
      "events": ["lost", "recover", "boot", "booted", "lease"],
      "states": ["lost", "shutdown", "booting", "ready", "leased"]
    },
    {
      "name": "a failed booted device gives its slot back only once shut down",
      "machine": "device",
      "start": "ready",
      "events": ["fail", "shutDown", "shutDownDone"],
      "states": ["failed", "shuttingDown", "shutdown"]
    },
    {
      "name": "a device that fails while shutting down is shut down again",
      "machine": "device",
      "start": "shuttingDown",
      "events": ["fail", "shutDown", "shutDownDone"],
      "states": ["failed", "shuttingDown", "shutdown"]
    },
    {
      "name": "a silent waiter is abandoned",
      "machine": "lease",
      "start": "waiting",
      "events": ["abandon"],
      "states": ["expired"]
    },
    {
      "name": "an unclaimed reservation lapses to the back of the queue, then a silent waiter is abandoned",
      "machine": "lease",
      "start": "waiting",
      "events": ["reserve", "lapse", "abandon"],
      "states": ["reserved", "waiting", "expired"]
    },
    {
      "name": "the dev-client build a waiter needs fails",
      "machine": "lease",
      "start": "waiting",
      "events": ["buildFailed"],
      "states": ["expired"]
    },
    {
      "name": "a takeover outlives its agent: the person drives until give back, then the lease is released",
      "machine": "lease",
      "start": "active",
      "events": ["takeover", "holderExited", "giveBack", "holderExited"],
      "states": ["takeover", "takeover", "active", "released"]
    },
    {
      "name": "a device deleted outside Pod ends the lease Filip drives: deviceLost, not released",
      "machine": "lease",
      "start": "active",
      "events": ["takeover", "holderExited", "deviceLost"],
      "states": ["takeover", "takeover", "expired"]
    },
    {
      "name": "a removed worktree ends a reserved lease before its holder claims",
      "machine": "lease",
      "start": "waiting",
      "events": ["reserve", "worktreeRemoved"],
      "states": ["reserved", "expired"]
    },
    {
      "name": "a pool device deleted outside Pod while simslim prepares it",
      "machine": "device",
      "start": "absent",
      "events": ["clone", "cloned", "lost", "forget"],
      "states": ["cloning", "preparing", "lost", "absent"]
    }
  ],
